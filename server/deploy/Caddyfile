# TLS terminator in front of askrypt-server.
#
# Caddy obtains and renews certificates automatically; the server itself
# speaks plain HTTP and must not be reachable from anywhere else, because
# ASKRYPT_TRUST_PROXY=1 tells it to believe the client-address headers set
# below.

askrypt.example.com {
	encode zstd gzip

	reverse_proxy askrypt-server:8080 {
		# Overwrite rather than append. Caddy's default appends the peer to
		# whatever the client sent, which would leave a forged address as the
		# first X-Forwarded-For element. The server reads the *last* element
		# precisely because proxies usually append — setting both headers to
		# the observed address removes the ambiguity entirely.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}

		# Slow-body and idle protection lives here: the server's request
		# timeout bounds handlers, not response-body streaming.
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}

	# The server sets its own security headers (CSP, HSTS, nosniff, ...);
	# don't duplicate them here or the two will drift.

	log {
		output file /var/log/caddy/askrypt.log
	}
}
