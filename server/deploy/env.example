# Template for the deployment's environment file.
#
# Copy to /home/askrypt-server/.env ON THE SERVER (docker compose reads a file
# named `.env` from the compose file's directory by itself) and fill it in:
#
#   install -D -m 600 env.example /home/askrypt-server/.env    # then edit it
#
# The deploy never uploads or reads it — it only checks that it exists and
# that ASKRYPT_DOMAIN is set. Keep the real file off version control: it
# holds the SMTP relay password.

# Required. The public hostname; Caddy requests a certificate for it.
ASKRYPT_DOMAIN=askrypt.example.com

# Email relay. Leaving ASKRYPT_SMTP_HOST empty is NOT "email disabled" — the
# server then logs each message in full, single-use tokens included.
ASKRYPT_SMTP_HOST=
ASKRYPT_SMTP_FROM=Askrypt <no-reply@example.com>
ASKRYPT_SMTP_ENCRYPTION=starttls
# Defaults per encryption mode: 587 starttls, 465 tls, 25 none.
ASKRYPT_SMTP_PORT=
ASKRYPT_SMTP_USERNAME=
ASKRYPT_SMTP_PASSWORD=

# Comma-separated OAuth client ids accepted as Google ID-token audiences.
# Empty disables Google sign-in (the endpoint answers 501).
ASKRYPT_GOOGLE_CLIENT_IDS=

# Concurrent argon2 hashes; each holds ~19 MiB. Empty inherits the CPU count,
# which is too much for a small VPS.
ASKRYPT_ARGON2_PARALLELISM=4

# Keep askrypt_server at info or lower: the audit log rides that target.
RUST_LOG=askrypt_server=info,info

# Overrides the image the compose file runs. The deploy ships
# askrypt-server:latest, so leave this alone unless pinning a loaded tag.
#ASKRYPT_IMAGE=askrypt-server:latest
